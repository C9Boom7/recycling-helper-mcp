{
  "name": "recycling-helper-mcp",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx src/server.ts",
    "build": "tsc && mkdir -p dist/data && cp src/data/*.json dist/data/",
    "start": "node dist/server.js",
    "validate:data": "node scripts/validate-data.mjs",
    "check:links": "node scripts/check-region-links.mjs",
    "fees:fetch": "node scripts/fetch-ordinance-fees.mjs",
    "fees:verify": "node scripts/verify-ordinance-fees.mjs",
    "measure:region": "tsx scripts/measure-region-resolution.ts",
    "measure:bulky": "pnpm build && node scripts/measure-bulky-items.mjs",
    "eval:data": "tsx scripts/evaluate-data.ts",
    "backlog:questions": "node scripts/report-question-backlog.mjs",
    "backlog:resolution": "pnpm build && node scripts/report-backlog-resolution.mjs",
    "measure:coverage": "tsx scripts/measure-coverage.ts",
    "backlog:auto": "node scripts/auto-backlog-queries.mjs",
    "backlog:auto:quality": "node scripts/auto-backlog-queries.mjs --input logs/quality-seed-queries.example.jsonl --region \"서울 강남구\"",
    "log:query": "node scripts/log-query.mjs",
    "check": "tsc --noEmit && tsc -p tsconfig.scripts.json && node scripts/validate-data.mjs && tsx scripts/evaluate-data.ts && tsx scripts/test-region-matching.ts",
    "smoke:mcp": "pnpm build && node scripts/smoke-mcp.mjs",
    "local:test": "pnpm check && pnpm smoke:mcp",
    "import:fees": "tsx scripts/import-bulky-fees.ts",
    "import:ordinance": "tsx scripts/import-ordinance-fees.ts"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.22.0",
    "express": "^5.1.0",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/express": "^5.0.5",
    "@types/node": "^24.10.1",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3"
  }
}
